  <!-- EN: Paying for with {0} -->
  <RealisticOrbitalTrade.PayWith.Silver>以{0}支付</RealisticOrbitalTrade.PayWith.Silver>

  <!-- EN: How would you like to pay for the {0}? -->
  <RealisticOrbitalTrade.HowPayForParts>你想怎麼賠償{0}？</RealisticOrbitalTrade.HowPayForParts>

  <!-- EN: Return the {0} -->
  <RealisticOrbitalTrade.PayForPartsWithParts>歸還{0}</RealisticOrbitalTrade.PayForPartsWithParts>

